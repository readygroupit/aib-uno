    <!--
      Logo del prompt, disponibile a livello globale: il prompt e' ormai
      costruito interamente lato client su ogni pagina (vedi hero.js), non
      solo quando il server manda un componente apposito - deve poter
      leggere l'url dell'immagine (con la sua versione ?v= per il cache-
      busting, stessa convenzione di View::asset() altrove) senza che ogni
      controller debba passarglielo.
    -->
    <script>window.UNO_LOGO = <?= json_encode($this->asset('/img/uno-icon-circle-transparent.png')) ?>;</script>
    <!-- Stessa forma di UNO_LOGO ma la versione squadrata: usata per il
         pulsante del wizard nella toolbar e per l'intestazione del
         modale (vedi hero.js/wizard.js). "-tight" = ritagliata sul
         contenuto vero dell'icona: il file originale ha un grosso
         margine color canvas incorporato nel PNG stesso (non e' un
         effetto CSS) che rendeva l'icona piccola dentro un riquadro
         chiaro - scoperto da uno screenshot dell'utente, corretto
         ritagliando e rendendo trasparenti i bordi invece di convivere
         con lo spazio vuoto. -->
    <script>window.UNO_LOGO_SQUARE = <?= json_encode($this->asset('/img/uno-icon-square-tight.png')) ?>;</script>
    <!--
      Stesso motivo di UNO_LOGO qui sopra: il pannello prompt (hero.js)
      manda le sue richieste a /prompt come corpo JSON, non come <form>,
      quindi il token CSRF non puo' viaggiare come campo nascosto (vedi
      FormComponent/View::csrfField() per quel caso) - qui serve un
      header, letto lato server da Request::csrfHeader().
    -->
    <script>window.UNO_CSRF = <?= json_encode(\App\Core\Csrf::token()) ?>;</script>
    <!-- Blocco identita' in cima al menu profilo (vedi hero.js) - null sulle pagine non autenticate, calcolato qui sopra. -->
    <script>window.UNO_USER = <?= json_encode($unoUser) ?>;</script>
    <script>window.UNO_CAN_CONFIGURE = <?= json_encode(in_array('users.manage', $_SESSION['user']['permissions'] ?? [], true)) ?>;</script>
    <script>window.UNO_SHOW_ONBOARDING = <?= json_encode($unoShowOnboarding) ?>;</script>
    <script type="module" src="<?= $this->asset('/js/app.js') ?>"></script>
