
# Cache di css e js. Con la versione nell'indirizzo (?v=filemtime: View::asset()
# per i tag <link>/<script>, View::importMap() per gli import tra moduli) il
# file non cambia mai a quell'indirizzo: il browser lo tiene un anno senza
# richiederlo (prima, con "no-cache", ogni pagina ricontrollava ~100 file sul
# server, una andata e ritorno ciascuno: era la lentezza in produzione). Una
# modifica cambia ?v= e quindi l'indirizzo. Senza ?v= resta "no-cache", cosi'
# un F5 non serve mai una copia vecchia.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <If "%{QUERY_STRING} =~ /(^|&)v=\d+/ && %{REQUEST_URI} =~ /\.(js|css)$/">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

RewriteEngine On

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L]
