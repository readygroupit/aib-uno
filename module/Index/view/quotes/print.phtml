<?php
/**
 * Preventivo da stampare o salvare in PDF dal browser (Ctrl+P). Pagina a
 * se': niente menu, solo il documento (A4). In alto, fuori dalla stampa,
 * la barra con "Torna al preventivo" e "Stampa o salva in PDF".
 *
 * @var array $quote QuoteOverviewService::detail()
 * @var ?\App\Model\CompanyProfile $company
 * @var ?\App\Model\Customer $customer
 * @var int $quoteId
 * @var array $brand BrandingService::current()
 */
$companyName = $company?->companyName ?: APP_NAME;
$companyAddress = $company ? trim("{$company->address}, {$company->postalCode} {$company->city} ({$company->province})", ' ,()') : '';
$companyContacts = $company ? implode(' · ', array_filter([$company->email, $company->phone])) : '';
$details = array_filter([
    'Data' => $quote['date'],
    'Valido fino al' => $quote['validUntil'],
    'Referente' => $quote['owner'],
    'Pagamento' => $quote['paymentTerms'],
]);
$grand = $quote['totals'] !== [] ? end($quote['totals']) : null;
// Senza i dati dell'agenzia (Dati azienda) il riquadro "Da" resterebbe vuoto: non si mostra.
$showFrom = $companyAddress !== '' || $companyContacts !== '' || (string) ($company?->vatNumber ?? '') !== '';
?>
<!doctype html>
<html lang="it">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= $this->e($title) ?> · <?= $this->e($quote['customer']) ?></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<?= $this->asset('/css/tokens.css') ?>">
    <link rel="stylesheet" href="<?= $this->asset('/css/components/quote-print.css') ?>">
</head>
<body class="qp">
<nav class="qp__bar" aria-label="Azioni">
    <a class="qp__back" href="/preventivi/<?= (int) $quoteId ?>">&larr; Torna al preventivo</a>
    <span class="qp__bar-hint">Nella finestra di stampa scegli "Salva come PDF" per avere il file.</span>
    <button type="button" class="qp__print" onclick="window.print()">Stampa o salva in PDF</button>
</nav>

<main class="qp__page">
    <header class="qp__head">
        <div class="qp__brand">
            <?php if (!empty($brand['logo'])): ?>
                <img class="qp__logo" src="<?= $this->e($brand['logo']) ?>" alt="<?= $this->e($companyName) ?>">
            <?php else: ?>
                <div class="qp__company"><?= $this->e($companyName) ?></div>
            <?php endif; ?>
        </div>
        <div class="qp__doc">
            <div class="qp__doc-label">Preventivo</div>
            <div class="qp__doc-number"><?= $this->e($quote['number']) ?></div>
        </div>
    </header>

    <section class="qp__parties">
        <?php if ($showFrom): ?>
        <div class="qp__party">
            <div class="qp__label">Da</div>
            <div class="qp__party-name"><?= $this->e($companyName) ?></div>
            <?php if ($companyAddress !== ''): ?><div class="qp__small"><?= $this->e($companyAddress) ?></div><?php endif; ?>
            <?php if ($company?->vatNumber): ?><div class="qp__small">P.IVA <?= $this->e($company->vatNumber) ?></div><?php endif; ?>
            <?php if ($companyContacts !== ''): ?><div class="qp__small"><?= $this->e($companyContacts) ?></div><?php endif; ?>
        </div>
        <?php endif; ?>
        <div class="qp__party qp__party--to">
            <div class="qp__label">Per</div>
            <div class="qp__party-name"><?= $this->e($quote['customer']) ?></div>
            <?php if ($customer): ?>
                <?php if ($customer->address): ?><div class="qp__small"><?= $this->e($customer->address) ?></div><?php endif; ?>
                <?php if ($customer->vatNumber): ?><div class="qp__small">P.IVA / CF <?= $this->e($customer->vatNumber) ?></div><?php endif; ?>
                <?php if ($customer->email): ?><div class="qp__small"><?= $this->e($customer->email) ?></div><?php endif; ?>
            <?php endif; ?>
        </div>
    </section>

    <?php if ($details !== []): ?>
        <dl class="qp__details">
            <?php foreach ($details as $label => $value): ?>
                <div class="qp__detail"><dt><?= $this->e($label) ?></dt><dd><?= $this->e((string) $value) ?></dd></div>
            <?php endforeach; ?>
        </dl>
    <?php endif; ?>

    <h1 class="qp__title"><?= $this->e($quote['title']) ?></h1>
    <?php if ($quote['intro']): ?><p class="qp__intro"><?= nl2br($this->e($quote['intro'])) ?></p><?php endif; ?>

    <table class="qp__lines">
        <thead>
            <tr>
                <th class="qp__col-n">#</th>
                <th>Descrizione</th>
                <th class="qp__num">Q.ta'</th>
                <th class="qp__num">Prezzo</th>
                <th class="qp__num">Importo</th>
            </tr>
        </thead>
        <tbody>
        <?php foreach ($quote['lines'] as $i => $line): ?>
            <tr>
                <td class="qp__col-n"><?= $i + 1 ?></td>
                <td>
                    <div class="qp__line-title"><?= $this->e($line['description']) ?></div>
                    <?php if ($line['details']): ?><div class="qp__line-details"><?= nl2br($this->e($line['details'])) ?></div><?php endif; ?>
                    <?php if ($line['plan']): ?><div class="qp__line-plan">Pagamento: <?= $this->e($line['plan']) ?></div><?php endif; ?>
                </td>
                <td class="qp__num"><?= $this->e($line['qty']) ?></td>
                <td class="qp__num"><?= $this->e($line['unitPrice']) ?><?= $line['period'] ? '<div class="qp__line-plan">' . $this->e($line['period']) . '</div>' : '' ?></td>
                <td class="qp__num qp__amount"><?= $this->e($line['amount']) ?></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>

    <div class="qp__summary">
        <div class="qp__summary-note">
            Importi in euro, IVA esclusa.
            <?php if ($quote['revisions'] !== null): ?><br><?= (int) $quote['revisions'] ?> giri di modifiche compresi per ogni lavoro; oltre, quotati a parte.<?php endif; ?>
        </div>
        <div class="qp__totals">
            <?php if ($quote['discount']): ?>
                <div class="qp__total-row"><span>Sconto</span><span><?= $this->e($quote['discount']) ?></span></div>
            <?php endif; ?>
            <?php foreach ($quote['totals'] as $total): ?>
                <div class="qp__total-row<?= $total === $grand ? ' qp__total-row--grand' : '' ?>"><span><?= $this->e($total['label']) ?></span><strong><?= $this->e($total['value']) ?></strong></div>
            <?php endforeach; ?>
        </div>
    </div>

    <?php if ($quote['conditions']): ?>
        <section class="qp__block">
            <h2 class="qp__block-title">Condizioni</h2>
            <p><?= nl2br($this->e($quote['conditions'])) ?></p>
        </section>
    <?php endif; ?>

    <section class="qp__sign">
        <div class="qp__sign-box">
            <div class="qp__label">Per <?= $this->e($companyName) ?></div>
            <div class="qp__sign-line"></div>
        </div>
        <div class="qp__sign-box">
            <div class="qp__label">Per accettazione (timbro e firma)</div>
            <div class="qp__sign-line"></div>
            <div class="qp__small">Data ____ / ____ / ________</div>
        </div>
    </section>

    <footer class="qp__foot">
        <span><?= $this->e($companyName) ?><?= $company?->vatNumber ? ' · P.IVA ' . $this->e($company->vatNumber) : '' ?></span>
        <span>Preventivo <?= $this->e($quote['number']) ?><?= $quote['validUntil'] ? ' · valido fino al ' . $this->e($quote['validUntil']) : '' ?></span>
    </footer>
</main>
</body>
</html>
