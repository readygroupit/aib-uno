# Credenziali locali (DB, chiave API Claude) - vedi local.php.dist per il template da copiare
config/autoload/local.php

# Chiavi API (vedi secrets.php.dist): mai su GitHub
config/autoload/secrets.php

# Log/cache generati a runtime, non fanno parte del codice
data/logs/*
!data/logs/.gitkeep
data/cache/*
!data/cache/.gitkeep

# Metadati IDE locali (NetBeans)
nbproject/

.DS_Store

# File caricati dal primo accesso (logo): restano sul server, non nel codice
public/uploads/*
!public/uploads/.gitkeep
# Anteprime dell'archivio foto e video (si rigenerano) e cartella di prova in locale.
data/media-thumbs/
data/media-demo/
