<?php
// Chi e' collegato, per il blocco identita' in cima al menu profilo
// (vedi hero.js) - letto direttamente da $_SESSION['user'] (stesso dato
// cache-ato al login da AuthService, niente query qui): null se non
// autenticato (login/password dimenticata/reset), window.UNO_USER
// resta null e hero.js semplicemente non disegna quel blocco.
$unoUser = isset($_SESSION['user']['id']) ? [
    'initials' => mb_strtoupper(
        mb_substr((string) ($_SESSION['user']['firstName'] ?? ''), 0, 1)
        . mb_substr((string) ($_SESSION['user']['lastName'] ?? ''), 0, 1)
    ),
    'name' => trim(($_SESSION['user']['firstName'] ?? '') . ' ' . ($_SESSION['user']['lastName'] ?? '')),
    'role' => $_SESSION['user']['profileName'] ?? '',
] : null;

// Tour di benvenuto (vedi onboarding.js): si apre da solo finche' non
// viene chiuso con "Ho capito" (vedi AuthService::dismissOnboarding()).
// false anche da disconnessi - l'overlay non ha senso senza il menu
// profilo che lo ospita concettualmente.
$unoShowOnboarding = isset($_SESSION['user']['id']) && !($_SESSION['user']['onboardingSeen'] ?? false);
?>
